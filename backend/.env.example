┌─────────────────────────────────────────────────────────────────┐
│                        MOBILE APP                               │
│                                                                 │
│  User taps "Select image"                                       │
│         │                                                       │
│         ▼                                                       │
│  ImagePicker opens gallery                                      │
│  (expo-image-picker)                                            │
│         │                                                       │
│         │  asset = { uri, mimeType, fileSize, width, height }  │
│         ▼                                                       │
│  Check fileSize > 5MB? ──YES──► Alert "Image too large", stop  │
│         │                                                       │
│         │ NO                                                    │
│         ▼                                                       │
│  fetch(asset.uri) → get blob from local file                   │
│         │                                                       │
│         │  blob = raw image binary                             │
│         ▼                                                       │
│  ┌──────────────────────────────────────────────────────────┐  │
│  │  STEP 1: Ask backend for a signed Cloudinary URL         │  │
│  │                                                          │  │
│  │  POST /api/admin/uploads/question-image                  │  │
│  │  Authorization: Bearer <token>                           │  │
│  │  Body: { fileName, mimeType, size }                      │  │
│  └──────────────────────────────────────────────────────────┘  │
│         │                                                       │
└─────────┼───────────────────────────────────────────────────────┘
          │
          ▼
┌─────────────────────────────────────────────────────────────────┐
│                        BACKEND                                  │
│                                                                 │
│  authenticate → authorize(ADMIN) → validate schema              │
│         │                                                       │
│         ▼                                                       │
│  uploads.service.js                                             │
│  ├─ Check Cloudinary env vars configured?                       │
│  │       NO ──► throw 503 STORAGE_NOT_CONFIGURED                │
│  │       YES ▼                                                  │
│  ├─ Generate UUID as public_id                                  │
│  ├─ Build folder path:                                          │
│  │   institutes/<instituteId>/questions                         │
│  ├─ storageKey = folder/uuid                                    │
│  ├─ timestamp = now in seconds                                  │
│  └─ Sign { folder, public_id, timestamp, overwrite:false }      │
│       using CLOUDINARY_API_SECRET                               │
│         │                                                       │
│         │  Returns:                                             │
│         │  {                                                    │
│         │    uploadUrl: "https://api.cloudinary.com/...",       │
│         │    url: "https://res.cloudinary.com/...",  ← final    │
│         │    storageKey: "institutes/.../uuid",                 │
│         │    fields: { api_key, timestamp, signature,           │
│         │              public_id, folder, overwrite }           │
│         │  }                                                    │
└─────────┼───────────────────────────────────────────────────────┘
          │
          ▼
┌─────────────────────────────────────────────────────────────────┐
│                        MOBILE APP                               │
│                                                                 │
│  ┌──────────────────────────────────────────────────────────┐   │
│  │  STEP 2: Upload binary DIRECTLY to Cloudinary            │   │
│  │                                                          │   │
│  │  POST https://api.cloudinary.com/v1_1/<cloud>/image/upload│  │
│  │  Body: form-data                                         │   │
│  │    api_key, timestamp, signature,                        │   │
│  │    public_id, folder, overwrite  ← from fields           │   │
│  │    file = blob  ← actual image binary                    │   │
│  └──────────────────────────────────────────────────────────┘  │
│         │                                                       │
│         │  upload.ok? ──NO──► throw "The image upload failed"  │
│         │  YES ▼                                               │
│         ▼                                                       │
│  Return image block:                                            │
│  {                                                              │
│    type: "image",                                               │
│    url: signed.data.url,      ← Cloudinary CDN URL             │
│    storageKey: "...",                                           │
│    mimeType: "image/jpeg",                                      │
│    alt: "...",                                                  │
│    width, height                                                │
│  }                                                              │
│         │                                                       │
│         ▼                                                       │
│  Block saved in question content/option locally                 │
│         │                                                       │
│  User submits question form                                     │
│         │                                                       │
│  POST /api/admin/questions  ← image block included in body     │
└─────────────────────────────────────────────────────────────────┘
          │
          ▼
┌─────────────────────────────────────────────────────────────────┐
│                        BACKEND                                  │
│                                                                 │
│  questions.service.js                                           │
│  └─ For every image block in content/options:                   │
│       verifyQuestionImage(image)                                │
│       ├─ Call Cloudinary API: client.api.resource(storageKey)  │
│       ├─ File not found? ──► 400 INVALID_IMAGE_UPLOAD          │
│       └─ File size > 5MB or invalid? ──► 400 INVALID_IMAGE_UPLOAD│
│                                                                 │
│  All checks pass → save Question to MongoDB                     │
│  (only metadata stored, never the binary)                       │
└─────────────────────────────────────────────────────────────────┘
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/coaching_management
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGIN=*
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
CONNECTION_TIMEOUT_MS=5000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
MAX_REFRESH_SESSIONS=5
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret
CLOUDINARY_SIGNED_URL_TTL_SECONDS=300
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=MyStrongPassword123!
SEED_ADMIN_INSTITUTE_ID=000000000000000000000001
SEED_ADMIN_INSTITUTE_NAME=My Coaching Center
INSTITUTE_API_KEY=replace-with-a-strong-secret-key
