{
  "expo": {
    "name": "Mahapatra Coaching Center",
    "slug": "mahapatra-coaching-center",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "csm",
    "icon": "./assets/mahapatraCoaching.png",
    "splash": {
      "image": "./assets/RadiantDiwali_Festival_of_Lights.png",
      "resizeMode": "contain",
      "backgroundColor": "#F97316"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahapatra.coaching"
    },
    "android": {
      "package": "com.mahapatra.coaching"
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Coaching Management System to select question images and diagrams."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/mahapatraCoaching.jpeg"
    }
  }
}
